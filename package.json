{
  "name": "atoll-down-under",
  "version": "0.1.0",
  "description": "An original widescreen life-science exploration game",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "package:win": "node scripts/package.mjs win32",
    "test:e2e": "playwright test",
    "test:desktop": "node scripts/qa-desktop.mjs",
    "check": "node scripts/check-setup.mjs",
    "build:win": "node scripts/build-windows.mjs",
    "assets:manifest": "node scripts/asset-manifest.mjs",
    "postinstall": "node node_modules/electron/install.js",
    "setup:electron": "node node_modules/electron/install.js"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "electron": "^44.2.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.4"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ddevillier/atoll-down-under.git"
  }
}
